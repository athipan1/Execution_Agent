# Execution Agent

API_KEY=replace_me
BROKER_MODE=SIMULATOR

# Broker credentials only when BROKER_MODE=ALPACA
ALPACA_API_KEY_ID=replace_me
ALPACA_SECRET_KEY=replace_me

# Database gateway
DATABASE_AGENT_URL=http://database-agent:8004
DATABASE_AGENT_API_KEY=replace_me

# Important: Execution_Agent must not connect to PostgreSQL directly.
# Do not set DATABASE_URL here. Only Database_Agent should own DATABASE_URL.
